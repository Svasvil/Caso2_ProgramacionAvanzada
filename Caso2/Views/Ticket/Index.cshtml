@model IEnumerable<Caso2.Models.TicketViewModel>

@if (TempData["AltaDificultad"] != null)
{
    <div class="alert alert-warning text-center">
         @TempData["AltaDificultad"]
    </div>
}

<div class="mb-4 d-flex justify-content-center">
    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalCrearTicket">
        + Nuevo Ticket
    </button>
</div>

<div class="modal fade" id="modalCrearTicket" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Crear Ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @await Html.PartialAsync("_CreateTicketPartial", new Caso2.Models.TicketViewModel())
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-3 justify-content-center flex-wrap mt-4">

    <div class="bg-primary text-white p-3 rounded" style="width:300px; min-height:500px;">
        <h5 class="text-center"> Abierto</h5>
        @foreach (var t in Model.Where(t => t.Estado == Caso2.Models.TicketViewModel.EstadoTicket.Abierto))
        {
            <div class="card text-dark mb-2 p-2 shadow-sm">
                <h6 class="fw-bold">@t.Nombre</h6>
                <p class="mb-1">@t.Descripcion</p>
                <small><b>Dificultad:</b> @t.Dificultad</small><br />
                <small><b>Prioridad:</b> @t.Prioridad</small><br />
                <small><b>Asignado:</b> @(t.AsignadoA ?? "Sin asignar")</small>
                <form asp-action="NextTicket" method="post">
                    <input type="hidden" name="id" value="@t.Id" />
                    <button type="submit" class="btn btn-sm btn-dark mt-2 w-100">
                        Avanzar 
                    </button>
                </form>
            </div>
        }
    </div>

    <div class="bg-warning text-white p-3 rounded" style="width:300px; min-height:500px;">
        <h5 class="text-center"> En Proceso</h5>
        @foreach (var t in Model.Where(t => t.Estado == Caso2.Models.TicketViewModel.EstadoTicket.EnProceso))
        {
            <div class="card text-dark mb-2 p-2 shadow-sm">
                <h6 class="fw-bold">@t.Nombre</h6>
                <p class="mb-1">@t.Descripcion</p>
                <small><b>Dificultad:</b> @t.Dificultad</small><br />
                <small><b>Prioridad:</b> @t.Prioridad</small><br />
                <small><b>Asignado:</b> @(t.AsignadoA ?? "Sin asignar")</small>
                <form asp-action="NextTicket" method="post">
                    <input type="hidden" name="id" value="@t.Id" />
                    <button type="submit" class="btn btn-sm btn-dark mt-2 w-100">
                        Avanzar 
                    </button>
                </form>
            </div>
        }
    </div>

   
    <div class="bg-success text-white p-3 rounded" style="width:300px; min-height:500px;">
        <h5 class="text-center"> Cerrado</h5>
        @foreach (var t in Model.Where(t => t.Estado == Caso2.Models.TicketViewModel.EstadoTicket.Cerrado))
        {
            <div class="card text-dark mb-2 p-2 shadow-sm">
                <h6 class="fw-bold">@t.Nombre</h6>
                <p class="mb-1">@t.Descripcion</p>
                <small><b>Dificultad:</b> @t.Dificultad</small><br />
                <small><b>Prioridad:</b> @t.Prioridad</small><br />
                <small><b>Asignado:</b> @(t.AsignadoA ?? "Sin asignar")</small>
                <span class="badge bg-light text-dark mt-2"> Cerrado</span>
            </div>
        }
    </div>

</div>